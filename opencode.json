{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "godot": {
            "type": "local",
            "command": ["godot-mcp"],
            "environment": {
                "GODOT_PATH": "/usr/local/bin/godot"
            },
            "enabled": true
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer {env:GITHUB_TOKEN}"
            },
            "oauth": false,
            "enabled": true
        }
    }
}
