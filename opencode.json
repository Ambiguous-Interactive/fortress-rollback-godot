{
    "mcp": {
        "servers": {
            "godot": {
                "type": "local",
                "command": ["godot-mcp"],
                "environment": {
                    "GODOT_PATH": "/usr/local/bin/godot"
                }
            },
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp"
            },
            "github": {
                "type": "remote",
                "url": "https://api.githubcopilot.com/mcp/",
                "headers": {
                    "Authorization": "Bearer {env:GITHUB_TOKEN}"
                },
                "oauth": false
            }
        }
    }
}
