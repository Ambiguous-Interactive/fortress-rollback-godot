# Godot 4+ specific ignores
.godot/
/android/
*.translation

# Godot temporary/export artifacts
export_presets.cfg.orig
*.tmp

# Python (tooling, venvs)
__pycache__/
*.py[cod]
.venv/
venv/

# pre-commit
.pre-commit-cache/

# Devcontainer secrets (template: .devcontainer/devcontainer.env.example)
.devcontainer/devcontainer.env

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Machine-local caches, measurement artifacts and scratch copies (never committed)
/.cache/

# Machine-local session logs (never committed)
/progress/
