# Godot 4+ specific ignores
.godot/
/android/
*.translation

# Godot temporary/export artifacts
export_presets.cfg.orig
*.tmp

# Python (tooling, venvs)
__pycache__/
*.py[cod]
.venv/
venv/

# pre-commit
.pre-commit-cache/

# Devcontainer secrets (template: .devcontainer/devcontainer.env.example)
.devcontainer/devcontainer.env

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Verified development caches
/.cache/reference/
/.cache/tests/

# Agent measurement and issue-read artifacts
/.cache/session-*/

# Scratch copies of the working tree (machine-local, regenerable)
/.cache/scratch/

# Machine-local session logs (never committed)
/progress/
